# Copy to .env.local and fill in. Never commit .env.local.

# LLM used to write the grounded answer (any OpenAI-compatible endpoint).
# Google Gemini (free tier) through its OpenAI-compatible endpoint:
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# json_schema (provider enforces the schema) | prompt (format described in the prompt only)
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TIMEOUT_MS=30000

# Embeddings: "local" = all-MiniLM-L6-v2 running on your machine (downloaded once, ~25 MB).
# "mock" = deterministic hashing vectors, only for offline tests (retrieval quality is meaningless).
EMBEDDINGS=local

# Limits
MAX_QUESTION_CHARS=500
MAX_UPLOAD_BYTES=2000000
