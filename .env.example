# Copy to .env.local and fill in. Never commit .env.local.

# LLM used for the answers, the quizzes and the concept graph: ANY OpenAI-compatible chat endpoint.
#   LLM_URL      base URL of the API (the app calls <LLM_URL>/chat/completions)
#   LLM_API_KEY  its key (can stay empty for a local server that needs none)
#   LLM_MODEL    the model name that endpoint expects
# Default: Google Gemini (free tier) through its OpenAI-compatible endpoint.
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Other examples:
#   OpenAI:          LLM_URL=https://api.openai.com/v1                LLM_MODEL=gpt-4o-mini
#   Ollama (local):  LLM_URL=http://localhost:11434/v1               LLM_MODEL=llama3.1
#   LM Studio:       LLM_URL=http://localhost:1234/v1                LLM_MODEL=<the loaded model>
# (LLM_BASE_URL, the old name of LLM_URL, is still accepted.)
# json_schema (provider enforces the schema) | prompt (format described in the prompt only).
# If the endpoint refuses json_schema (HTTP 400/422) the app switches to "prompt" by itself.
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TIMEOUT_MS=30000

# Embeddings: "local" = all-MiniLM-L6-v2 running on your machine (downloaded once, ~25 MB).
# "mock" = deterministic hashing vectors, only for offline tests (retrieval quality is meaningless).
EMBEDDINGS=local

# Limits
MAX_QUESTION_CHARS=500
MAX_UPLOAD_BYTES=2000000

# Batch LLM calls (evaluation answers, graph build): pause before each call, wait after a 429/503
LLM_BATCH_DELAY_MS=1500
LLM_BATCH_RETRY_WAIT_MS=20000

# V4 · traces (data/traces/, never committed): how many days they are kept
TRACE_RETENTION_DAYS=30
# Price used to show a cost for each AI call, in USD per million tokens. On the Gemini free tier
# the real cost is 0: set both to 0. Defaults = paid list price of gemini-3.1-flash-lite.
LLM_PRICE_INPUT_PER_M=0.25
LLM_PRICE_OUTPUT_PER_M=1.5
